# Vorlage für /etc/buchhaltung.env (Rechte 640, gehört root:buchhaltung).
# Lokal: Kopie nach backend/.env — dort genügen DATABASE_URL und ADMIN_PASSWORT.

# Datenbank. Lokal SQLite, auf dem Server PostgreSQL.
DATABASE_URL=sqlite:///./buchhaltung-lokal.db
# DATABASE_URL=postgresql+psycopg://buchhaltung:GEHEIM@127.0.0.1:5432/buchhaltung

# Erster Administrator. Wird nur gelesen, solange die Tabelle benutzer leer ist.
# Danach in der UI unter Benutzer verwalten.
ADMIN_BENUTZER=admin
ADMIN_PASSWORT=hier-sicheres-passwort-eintragen

# Session-Cookie. CHANGE_ME wird beim ersten Start ersetzt und hier gespeichert.
BUCHHALTUNG_SESSION_SECRET=CHANGE_ME
# Hinter HTTPS (Produktion) auf true setzen.
COOKIE_SECURE=false

# Wo die App ihre Umgebungsdatei zum Schreiben (SMTP, Azure, Session-Secret) findet.
BUCHHALTUNG_ENV_DATEI=/etc/buchhaltung.env

# SMTP für Rechnungs- und DATEV-Versand. Ohne Host und Absender kein Versand.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Beleg-Postfach (IMAP) für den automatischen Belegimport. Ohne Host kein Abruf.
# Auch in der UI pflegbar (Einstellungen, E-Mail & Postfach). Auf dem Server
# holt buchhaltung-mailimport.timer alle 15 Minuten ungesehene Mails ab.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_ORDNER=INBOX
# Ablage für verarbeitete Mails. Leer = nur als gelesen markieren.
IMAP_ERLEDIGT=
# Quelle, unter der Mail-Anhänge als Belege landen.
IMAP_QUELLE=eingang

# Ablage der Belegdateien. Leer = /var/lib/buchhaltung/belege.
# Lokal bitte setzen, z. B. BELEG_ORDNER=./belege (relativ zum Backend-Ordner).
BELEG_ORDNER=

# Optionale E-Rechnungs-Prüfung mit Mustang (Java + JAR). Leer = aus.
MUSTANG_JAVA=
MUSTANG_JAR=

# Optionale Azure-KI zur Belegerkennung (nur auf Knopfdruck in der UI). Leer = aus.
AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_DEPLOYMENT=

# development oder production. Nur production vertraut ausschließlich den
# konfigurierten WebAuthn-Origins.
ENVIRONMENT=development

# Öffentliche Adresse der App. Steht in Einladungs- und Reset-Mails und ist
# der Fallback für WebAuthn (rp_id und Origins).
PUBLIC_URL=http://127.0.0.1:5173

# Passkeys: Relying-Party-ID (Hostname) und erlaubte Browser-Origins
# (kommagetrennt). Leer = aus PUBLIC_URL abgeleitet.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=

# Optionale Anmeldung gegen LDAP/Active Directory. Aus = nur lokale Konten.
LDAP_ENABLED=false
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=
LDAP_USER_FILTER=(sAMAccountName={username})
